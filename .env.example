# flakewatch configuration (SPEC §13.2).
# Copy to .env and adjust. Every value shown is the default.

# API port (1-65535)
PORT=4000

# SQLite database file. The folder is created if missing.
DATABASE_PATH=./data/flakewatch.db

# Flake rate at which a test is automatically quarantined (0 < value <= 1)
QUARANTINE_THRESHOLD=0.10

# Minimum commits in the scope before automatic quarantine applies (integer >= 1)
QUARANTINE_MIN_COMMITS=20

# Consecutive all-failing commits that mark a test broken (integer >= 2)
BROKEN_MIN_COMMITS=3

# Raw results older than this many days are deleted (integer >= 37)
RETENTION_DAYS=90

# Maximum JUnit report size in MB (1 MB = 1,048,576 bytes)
MAX_UPLOAD_MB=10

# Optional write token. If set, uploads and quarantine changes must send
# "Authorization: Bearer <token>". Leave empty to disable.
UPLOAD_TOKEN=

# Origins allowed to call the API from a browser, comma-separated, e.g.
# http://localhost:4173. Leave empty in development: the dashboard uses the dev proxy.
CORS_ORIGINS=

# Optional fixed "now" as an ISO date-time, for tests and demos.
# Leave empty to use the real clock.
FLAKEWATCH_NOW=

# Dashboard: base URL of the API. Leave empty to use the same origin
# (in development, the dev server proxies /api to http://localhost:4000).
VITE_API_URL=
