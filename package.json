{
  "name": "flakewatch",
  "version": "0.0.0",
  "private": true,
  "description": "Detect, rank, and quarantine flaky tests from CI results.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web",
    "tools/seed",
    "tools/spec-check",
    "tools/bench",
    "e2e"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "build": "npm run build --workspaces --if-present && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w e2e",
    "dev": "node -e \"console.log('dev servers are added in T-07 (API) and T-26 (web).')\"",
    "spec:check": "tsx tools/spec-check/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.5"
  }
}
