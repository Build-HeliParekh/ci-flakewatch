{
  "name": "flakewatch",
  "version": "0.0.0",
  "private": true,
  "description": "Detect, rank, and quarantine flaky tests from CI results.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web",
    "tools/seed",
    "tools/spec-check",
    "tools/bench",
    "e2e"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "build": "npm run build --workspaces --if-present && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build -w packages/shared",
    "test:e2e": "npm run test:e2e -w e2e",
    "bench": "tsx tools/bench/src/run.ts",
    "dev": "concurrently --names api,web --prefix-colors blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "spec:check": "tsx tools/spec-check/src/cli.ts",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "retention": "npm run retention -w apps/api",
    "seed": "tsx tools/seed/src/cli.ts",
    "seed:demo": "tsx tools/seed/src/cli.ts --end today",
    "pretest": "npm run build -w packages/shared",
    "predev": "npm run build -w packages/shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.5",
    "yaml": "^2.8.1"
  }
}
